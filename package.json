  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "sarvam",
    "sarvam-105b",
    "openai-compat"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --import ./test/no-network.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "live": "node live/check.ts"
  }
}
